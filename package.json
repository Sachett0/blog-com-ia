{
  "name": "quiz",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "build": "docker build -t blog-com-ia .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "env:setup": "node -e \"require('node:fs').copyFileSync('.env.example', '.env.local')\"",
    "local:setup": "npm run env:setup && npm run dev",
    "db:up": "docker compose up -d",
    "db:migrate": "node --env-file=.env.local src/database/migrate.js"
  },
  "dependencies": {
    "@mastra/core": "^1.80.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
